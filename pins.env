# Everything that determines what gets built. CI exports these; each
# maintenance branch (v3.8.x, ...) differs from main only here.
PANDOC_VERSION=3.9.0.2
# Hackage snapshot for dependency resolution: the time upstream published
# this release, so builds resolve what upstream could have resolved.
INDEX_STATE=2026-03-19T13:01:03Z
# Toolchain upstream used for this release (see its release workflows).
GHC_VERSION=9.10.3
CABAL_VERSION=3.14.2.0
# quay.io/benz0li/ghc-musl:9.10, pinned by digest (GHC 9.10.3)
GHC_MUSL_IMAGE=quay.io/benz0li/ghc-musl@sha256:ef37c38911abb71011fb68066eb2723e8e83d1d2f4f464e34a9ac24838101d73
# pandoc-crossref tag built against this pandoc, in the same job: the newest
# tag whose pandoc bounds admit PANDOC_VERSION. If none does yet, the newest
# tag, with its bounds patched in patches/pandoc-crossref/<tag>/; its test
# suites must then pass against this pandoc (scripts/build-crossref.sh).
CROSSREF_TAG=v0.3.24a
# Build numbers of this branch's packages. A packaging fix to a published
# version bumps the one it affects; a new PANDOC_VERSION resets all three to 0.
# They live here, not in the recipes, so that merging main into a maintenance
# branch never changes that branch's build numbers.
PANDOC_BUILD_NUMBER=1
PANDOC_WASM_BUILD_NUMBER=1
CROSSREF_BUILD_NUMBER=0
